# Application Runtime Configuration (copy to .env on server; never commit .env)
NODE_ENV=production
PORT=3000

# Frontend Public Configuration (bundled into client build)
VITE_APP_ENV=production
VITE_APP_NAME=UsDigital-BMU

# Server-Only Authentication & Session Secrets (REQUIRED in production; keep server-side only)
SESSION_SECRET=
ADMIN_PASSCODE=
DEMO_PASSCODE=
# Optional override for Cnelson demonstration profile passcode
CATHERINE_PASSCODE=