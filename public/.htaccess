# UsDigital-BMO Generic HTTPS Redirect & Apache Security Rules
# Automatically included in Vite's `dist/.htaccess` production build.
# Works for ANY domain or subdomain hosted on cPanel (not tied to a single domain).

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force-redirect all non-HTTPS traffic to HTTPS on any non-local domain
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteCond %{HTTP:X-Forwarded-SSL} !on [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block direct HTTP access to sensitive dotfiles if served from web root
<FilesMatch "^\.(env|git|htaccess)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
