# UsDigital-BMO Apache / LiteSpeed Companion Rules
# NOTE: On cPanel "Setup Node.js App" (Phusion Passenger), cPanel automatically
# appends Passenger directives to the domain's .htaccess. Keep those Passenger
# lines intact and do NOT add static index.html RewriteRules that intercept
# /api/* or server-side Node.js routes.

# Optional: Uncomment after enabling AutoSSL / SSL certificate on bbmoglobal.online
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block direct HTTP access to sensitive dotfiles and server source files if served from web root
<FilesMatch "^\.(env|git|htaccess)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
